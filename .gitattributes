# Protect committed binary figures from line-ending mangling on the Windows filesystem,
# and keep text sources LF so CI (Ubuntu) and local (WSL/Windows) agree.
*.png   binary
*.jpg   binary
*.ico   binary

*.md    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Workflow scripts must stay LF in the working tree: the Claude Code Workflow tool
# rejects scripts containing CR as "control characters" in the approval dialog.
.claude/workflows/*.js text eol=lf
