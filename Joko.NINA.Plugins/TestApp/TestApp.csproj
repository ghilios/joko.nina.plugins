<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Custom CLI entry point. App.xaml stays an ApplicationDefinition (its generated App.Main is still
         reachable for the GUI path); StartupObject disambiguates the two Main methods. -->
    <StartupObject>TestApp.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoStdLib>true</NoStdLib>
    <NoWarn>1701;1702;CA1416;NU1701</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoStdLib>true</NoStdLib>
    <NoWarn>1701;1702;CA1416;NU1701</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;CA1416;NU1701</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;CA1416;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Joko.NINA.Plugins.HocusFocus\Joko.NINA.Plugins.HocusFocus.csproj" />
  </ItemGroup>
  <!-- The checked-in synthetic-bank spec (TestApp/SynthBank/synthetic-bank-spec.json, workstream G7) needs to
       land beside the built exe so the synth-bank CLI's default spec argument resolves without an absolute
       path. No prior None/CopyToOutputDirectory convention exists in this csproj (checked before adding this),
       so this is the first. -->
  <ItemGroup>
    <None Include="SynthBank\synthetic-bank-spec.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!--
  <ItemGroup>
    <Analyzer Include="..\packages\Microsoft.CodeAnalysis.Analyzers.3.3.2\analyzers\dotnet\cs\Microsoft.CodeAnalysis.Analyzers.dll" />
    <Analyzer Include="..\packages\Microsoft.CodeAnalysis.Analyzers.3.3.2\analyzers\dotnet\cs\Microsoft.CodeAnalysis.CSharp.Analyzers.dll" />
  </ItemGroup>
  -->
  <ItemGroup>
    <PackageReference Include="alglib.net" Version="3.19.0" />
    <PackageReference Include="Dirkster.AvalonDock" Version="4.70.3" />
    <PackageReference Include="ILGPU" Version="1.5.3" />
    <PackageReference Include="KdTree" Version="1.4.1" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.2.0" />
    <PackageReference Include="NINA.Plugin" Version="3.2.0.2001-beta" />
    <PackageReference Include="OpenCvSharp4" Version="4.6.0.20220608" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.6.0.20220608" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.6.0.20220608" />
    <PackageReference Include="ScottPlot.WPF" Version="4.1.59" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="Microsoft.DotNet.UpgradeAssistant.Extensions.Default.Analyzers" Version="0.4.355802">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="echo TargetPath3: $(TargetPath)" />
  </Target>
  <!-- NINA.Image's FITS loader P/Invokes cfitsionative.dll (plus pthreadVC2/zlib) from
       <appdir>\External\x64\Cfitsio, a tree NINA's installer deploys but no NuGet package ships —
       without it TestApp's headless diagnostics die on .fits with DllNotFoundException. Mirror it
       from a local NINA installation; when NINA isn't installed the wildcard expands empty and the
       copy is a quiet no-op (.xisf/.tif still work). Override NinaInstallDir if installed elsewhere. -->
  <PropertyGroup>
    <NinaInstallDir Condition="'$(NinaInstallDir)' == ''">$(ProgramFiles)\N.I.N.A. - Nighttime Imaging 'N' Astronomy</NinaInstallDir>
  </PropertyGroup>
  <Target Name="CopyNinaCfitsioNatives" AfterTargets="Build">
    <ItemGroup>
      <NinaCfitsioNatives Include="$(NinaInstallDir)\External\x64\Cfitsio\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(NinaCfitsioNatives)" DestinationFiles="@(NinaCfitsioNatives->'$(OutDir)External\x64\Cfitsio\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
