            <!--  Detection-binning recommendation. Sits directly below the settings grid (Detection Binning is
                  that grid's last row), NOT inside it: a wrapping TextBlock in a shared-size grid cell can fail
                  to converge its measure when UI Automation forces a re-measure, pegging the UI thread — see
                  OptionsDataTemplatesLayoutTests. Outside the grid it can wrap freely and cannot widen the
                  shared label/value columns. Hidden unless it has something to ask for.  -->
            <TextBlock
                MaxWidth="560"
                Margin="10,4,5,0"
                HorizontalAlignment="Left"
                FontStyle="Italic"
                Foreground="{StaticResource PrimaryBrush}"
                Text="{Binding StarDetectionOptions.DetectionBinningHint}"
                TextWrapping="Wrap"
                ToolTip="{Binding StarDetectionOptions.DetectionBinningHintDetail}"
                Visibility="{Binding StarDetectionOptions.DetectionBinningRecommendationVisible, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />

            <!--  Per-filter star detection: master toggle (always visible) + the editing-filter selector and
                  copy-from row (shown only while the feature is on, via the RowDefinition-style pattern). A
                  separate grid BELOW the settings grid and above Import/Export, sharing the settings grid's
                  label/value size groups so columns stay aligned with it.
                  Binding paths (PerFilterStore.*, PerFilterEditBinder.*, CopyStarDetectionFromFilterCommand)
                  resolve on BOTH hosts: HocusFocusPlugin (plugin options page) and StarDetectionOptionsVM
                  (Imaging dockable) expose identically-named instance properties.  -->
            <Grid Margin="5,0,5,0" HorizontalAlignment="Left">
                <Grid.Resources>
                    <Style x:Key="ShowOnPerFilterEnabled" TargetType="{x:Type RowDefinition}">
                        <Setter Property="Height" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PerFilterStore.Enabled}" Value="True">
                                <Setter Property="Height" Value="Auto" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="HF_SDCol0" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="HF_SDCol1" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Style="{StaticResource ShowOnPerFilterEnabled}" />
                    <RowDefinition Style="{StaticResource ShowOnPerFilterEnabled}" />
                    <RowDefinition Style="{StaticResource ShowOnPerFilterEnabled}" />
                    <RowDefinition Style="{StaticResource ShowOnPerFilterEnabled}" />
                    <RowDefinition Style="{StaticResource ShowOnPerFilterEnabled}" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Per-Filter Star Detection"
                    ToolTip="{StaticResource PerFilterStarDetectionEnabled_Tooltip}" />
                <CheckBox
                    Grid.Row="0"
                    Grid.Column="1"
                    MinWidth="80"
                    Margin="5,5,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding PerFilterStore.Enabled}"
                    ToolTip="{StaticResource PerFilterStarDetectionEnabled_Tooltip}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Editing Filter"
                    ToolTip="{StaticResource EditedFilterName_Tooltip}" />
                <ComboBox
                    Name="PART_EditedFilterList"
                    Grid.Row="1"
                    Grid.Column="1"
                    MinWidth="80"
                    Margin="5,5,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding PerFilterEditBinder.AvailableFilterNames}"
                    SelectedItem="{Binding PerFilterEditBinder.EditedFilterName}"
                    ToolTip="{StaticResource EditedFilterName_Tooltip}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Copy Settings From"
                    ToolTip="{StaticResource CopyStarDetectionFromFilter_Tooltip}" />
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <ComboBox
                        MinWidth="80"
                        Margin="5,5,0,0"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding PerFilterEditBinder.AvailableFilterNames}"
                        SelectedItem="{Binding PerFilterEditBinder.CopySourceFilterName, Mode=TwoWay}"
                        ToolTip="{StaticResource CopyStarDetectionFromFilter_Tooltip}" />
                    <!--  IsEnabled (not a command canExecute) gates the button on a chosen source: CommunityToolkit
                          commands never requery on a parameter change, so a predicate would latch it disabled.
                          CanCopyFromFilter tracks CopySourceFilterName, which the copy flow clears when it finishes.  -->
                    <Button
                        Margin="8,5,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding CopyStarDetectionFromFilterCommand}"
                        CommandParameter="{Binding PerFilterEditBinder.CopySourceFilterName}"
                        IsEnabled="{Binding PerFilterEditBinder.CanCopyFromFilter}"
                        ToolTip="{StaticResource CopyStarDetectionFromFilter_Tooltip}">
                        <TextBlock
                            Margin="10,5,10,5"
                            Foreground="{StaticResource ButtonForegroundBrush}"
                            Text="Copy"
                            TextWrapping="Wrap" />
                    </Button>
                </StackPanel>
                <!--  Auto-focus sweep geometry stored WITH this filter's settings set. These are focuser numbers on a
                      star-detection page on purpose: they belong to the per-filter set, and this block is the only
                      surface that edits per-filter sets. The header names that so it does not read as a stray control.
                      The header spans both shared-size columns, which the layout guard permits because it does not
                      wrap (only wrapping + ColumnSpan > 1 livelocks the re-measure).
                      NO validation rule on either box: rules run on the RAW text before the converter and would
                      reject the deliberately blank "inherit" state, exactly as documented on the Camera Simulator's
                      Focuser Step Size row. Out-of-range input is coerced in the binder's setter instead.
                      The dimmed inherited-value hint is drawn as an overlaid TextBlock rather than via HintTextBox:
                      that control's hint opacity is not settable in the NINA version this plugin builds against,
                      and its 0.4 default (fine for a static "(AutoFocus)" label) is too faint for a number the
                      user is meant to read and compare a typed value against. 0.6 matches the de-emphasis used for
                      secondary text elsewhere in this plugin.  -->
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,10,0,0"
                    FontStyle="Italic"
                    Foreground="{StaticResource PrimaryBrush}"
                    Text="Auto-Focus Sweep for This Filter"
                    ToolTip="{StaticResource PerFilterSweepHeader_Tooltip}" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Step Size"
                    ToolTip="{StaticResource PerFilterSweepStepSize_Tooltip}" />
                <Grid
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="5,5,0,0"
                    HorizontalAlignment="Left">
                    <TextBox
                        MinWidth="80"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Foreground="{StaticResource PrimaryBrush}"
                        TextAlignment="Left"
                        ToolTip="{StaticResource PerFilterSweepStepSize_Tooltip}">
                        <TextBox.Text>
                            <Binding
                                Converter="{StaticResource HF_DoubleNegativeToEmptyStringConverter}"
                                Mode="TwoWay"
                                Path="PerFilterEditBinder.SweepStepSizeOverride"
                                UpdateSourceTrigger="LostFocus" />
                        </TextBox.Text>
                    </TextBox>
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource PrimaryBrush}"
                        IsHitTestVisible="False"
                        Opacity="0.6"
                        Text="{Binding PerFilterEditBinder.ProfileSweepStepSize, Mode=OneWay}"
                        ToolTip="{StaticResource PerFilterSweepStepSize_Tooltip}"
                        Visibility="{Binding PerFilterEditBinder.SweepStepSizeInherits, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                </Grid>
                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Initial Offset Steps"
                    ToolTip="{StaticResource PerFilterSweepOffsetSteps_Tooltip}" />
                <Grid
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="5,5,0,0"
                    HorizontalAlignment="Left">
                    <TextBox
                        MinWidth="80"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Foreground="{StaticResource PrimaryBrush}"
                        TextAlignment="Left"
                        ToolTip="{StaticResource PerFilterSweepOffsetSteps_Tooltip}">
                        <TextBox.Text>
                            <Binding
                                Converter="{StaticResource HF_DoubleNegativeToEmptyStringConverter}"
                                Mode="TwoWay"
                                Path="PerFilterEditBinder.SweepOffsetStepsOverride"
                                UpdateSourceTrigger="LostFocus" />
                        </TextBox.Text>
                    </TextBox>
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource PrimaryBrush}"
                        IsHitTestVisible="False"
                        Opacity="0.6"
                        Text="{Binding PerFilterEditBinder.ProfileSweepOffsetSteps, Mode=OneWay}"
                        ToolTip="{StaticResource PerFilterSweepOffsetSteps_Tooltip}"
                        Visibility="{Binding PerFilterEditBinder.SweepOffsetStepsInherits, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                </Grid>
            </Grid>
            <!--  Active-filter warning: a standalone full-width message BELOW the per-filter grid, deliberately NOT a
                  cell in that grid. A wrapping TextBlock must not span the grid's Auto SharedSizeGroup columns
                  (HF_SDCol0/HF_SDCol1 are shared with the settings grid): a wrapping cell spanning shared columns
                  whose widths are negotiated across two grids does not converge under a UI-Automation-driven
                  re-measure and livelocks the UI thread. Here it wraps within its own bounded MaxWidth, clear of the
                  shared-size scope. Collapses (via its Style) whenever there is nothing to warn about, which is
                  already the case whenever per-filter detection is off.  -->
            <TextBlock
                Margin="5,6,5,0"
                MaxWidth="420"
                HorizontalAlignment="Left"
                FontStyle="Italic"
                Foreground="{StaticResource NotificationWarningBrush}"
                Text="{Binding PerFilterEditBinder.ActiveFilterWarning}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PerFilterEditBinder.HasActiveFilterWarning}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!--  Import / Export the star-detection parameters only (tune on a fast machine, import on the imaging machine).  -->
            <StackPanel
                Margin="5,10,5,5"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding ImportStarDetectionSettingsCommand}"
                    ToolTip="{StaticResource ImportStarDetectionSettings_Tooltip}">
                    <TextBlock
                        Margin="10,5,10,5"
                        Foreground="{StaticResource ButtonForegroundBrush}"
                        Text="Import"
                        TextWrapping="Wrap" />
                </Button>
                <Button
                    Command="{Binding ExportStarDetectionSettingsCommand}"
                    ToolTip="{StaticResource ExportStarDetectionSettings_Tooltip}">
                    <TextBlock
                        Margin="10,5,10,5"
                        Foreground="{StaticResource ButtonForegroundBrush}"
                        Text="Export"
                        TextWrapping="Wrap" />
                </Button>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
