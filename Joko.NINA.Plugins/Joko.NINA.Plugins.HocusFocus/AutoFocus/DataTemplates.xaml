                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Screw 2" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Screw 3" />
