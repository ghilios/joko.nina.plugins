                                Grid.Row="1"
                                Grid.Column="5"
                                Margin="5"
                                VerticalAlignment="Center"
                                ToolTip="{StaticResource SensorModel_CurvatureEffect_Tooltip}">
                                <Run Text="{Binding SensorModel.SensorModelResult.CurvatureEffectMicrons, StringFormat=\{0:0.\}, Mode=OneWay}" /> <Run Text="microns" />
                            </TextBlock>
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="Tilt Effect"
