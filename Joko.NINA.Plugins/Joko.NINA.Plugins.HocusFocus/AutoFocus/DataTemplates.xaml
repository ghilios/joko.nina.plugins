                                    Grid.Row="1"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="Tilt" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    Text="{Binding TiltGuidance.Screw1TiltArrow}" />
                                <TextBlock
                                    Grid.Row="1"
