                            <TextBlock
                                Margin="5,4,5,2"
                                controls:IconizedText.Text="{Binding TiltGuidance.DirectionLegend}"
                                TextWrapping="Wrap"
                                Visibility="{Binding TiltGuidance.HasDirectionLegend, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
