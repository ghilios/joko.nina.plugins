                                Grid.Row="1"
                                Margin="10,5,10,0"
                                HorizontalAlignment="Center"
                                AutoGenerateColumns="False"
                                ColumnWidth="Auto"
                                IsReadOnly="True"
                                ItemsSource="{Binding SensorModel.SensorModelResult.AnalysisResults}">
