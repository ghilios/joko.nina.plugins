                </UniformGrid>
                <UniformGrid
                    Margin="0,5,0,0"
                    VerticalAlignment="Center"
                    Columns="2"
                    Visibility="{Binding SelectedHyperbolicFitModel, Converter={StaticResource HF_NullToVisibilityCollapsedConverter}}">
