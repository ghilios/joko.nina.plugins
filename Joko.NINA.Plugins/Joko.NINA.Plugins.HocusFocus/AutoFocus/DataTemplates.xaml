                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="10,0,10,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontStyle="Italic"
                                Text="Use for tilt direction, not amount! Model always scaled to fit" />
