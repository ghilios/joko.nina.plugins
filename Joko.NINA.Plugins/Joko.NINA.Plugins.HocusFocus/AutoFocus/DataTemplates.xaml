                                Grid.Row="3"
                                Grid.Column="5"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="{Binding SensorModel.SensorModelResult.FRatio, StringFormat=\{0:0.0\}, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="Critical Focus"
