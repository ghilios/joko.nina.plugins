                            Text="Interpolation Smoothing" />
                        <ComboBox
                            Name="PART_InterpolationAmountList"
                            Grid.Row="7"
                            Grid.Column="3"
                            MinWidth="80"
                            Margin="5,5,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding Source={util:EnumBindingSource {x:Type hfenum:InterpolationAmountEnum}}}"
                            SelectedItem="{Binding InspectorOptions.InterpolationAmount}">
                            <ComboBox.ItemTemplate>
