                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Screw 4"
                                    Visibility="{Binding TiltGuidance.HasFourScrews, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                <!--  Tilt row  -->
