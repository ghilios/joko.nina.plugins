                                    Width="Auto"
                                    Binding="{Binding Path=TiltPlaneModel.BottomRight.AdjustmentRequiredSteps, StringFormat=\{0:0.#\}, Converter={StaticResource NaNToDoubleDashConverter}}"
                                    Header="Bottom Right" />
