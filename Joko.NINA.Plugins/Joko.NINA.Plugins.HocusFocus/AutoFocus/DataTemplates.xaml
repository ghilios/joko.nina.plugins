                            Text="Interpolation Algorithm" />
                        <ComboBox
                            Name="PART_InterpolationAlgoList"
                            Grid.Row="7"
                            Grid.Column="1"
                            MinWidth="80"
                            Margin="5,5,0,0"
                            HorizontalAlignment="Left"
