                            <CheckBox Margin="5,0,0,0" IsChecked="{Binding InspectorOptions.InterpolationEnabled}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="7"
                            Grid.Column="0"
                            Margin="5"
